# Copie para .env.local (desenvolvimento) e cadastre as mesmas na hospedagem
# (Netlify: Site configuration > Environment variables). NUNCA commite o .env.local.

# --- Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "publishable" (sb_publishable_...) — pode ir pro navegador, o RLS protege os dados
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave "secret" (sb_secret_...) — IGNORA o RLS. Só no servidor. Nunca com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Pix de quem recebe o sinal (a confeitaria) ---
# Use a CHAVE ALEATÓRIA (app do banco > Pix > Minhas chaves > Cadastrar chave aleatória):
# ela aparece para o cliente dentro do código Pix e não expõe CPF nem telefone.
PIX_CHAVE=00000000-0000-0000-0000-000000000000
# Nome do titular da conta (até 25 letras; acentos são removidos automaticamente)
PIX_NOME_RECEBEDOR=Nome do Titular
# Cidade (até 15 letras)
PIX_CIDADE=Salvador

# --- Site ---
# WhatsApp da confeitaria com DDD (só números). Aparece no rodapé e no botão "enviar comprovante".
NEXT_PUBLIC_WHATSAPP_LOJA=71999998888

# Segredo do agendamento diário que mantém o Supabase acordado.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=troque-por-um-valor-aleatorio-longo

# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel
# (Project > Settings > Environment Variables). NUNCA commite o .env.local.

# --- Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "publishable" (sb_publishable_...) — pode ir pro navegador, o RLS protege os dados
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave "secret" (sb_secret_...) — IGNORA o RLS. Só no servidor. Nunca com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Mercado Pago (Suas integrações > sua aplicação > Credenciais) ---
# Comece com o Access Token de TESTE; troque pelo de produção quando for ao ar.
MP_ACCESS_TOKEN=APP_USR-xxx
# Suas integrações > sua aplicação > Webhooks > "Assinatura secreta"
MP_WEBHOOK_SECRET=xxx

# --- Site ---
# URL pública do site (sem barra no final). Usada no retorno do pagamento e no webhook.
NEXT_PUBLIC_SITE_URL=https://seu-site.vercel.app
# WhatsApp da confeitaria com DDD (só números). Opcional: aparece no rodapé e no pedido.
NEXT_PUBLIC_WHATSAPP_LOJA=71999998888

# Segredo do cron que mantém o Supabase acordado. Gere com: openssl rand -hex 32
CRON_SECRET=troque-por-um-valor-aleatorio-longo

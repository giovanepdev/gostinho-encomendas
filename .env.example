# Copie para .env.local (desenvolvimento) e cadastre as mesmas na hospedagem
# (Netlify: Site configuration > Environment variables). NUNCA commite o .env.local.

# --- Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "publishable" (sb_publishable_...) — pode ir pro navegador, o RLS protege os dados
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave "secret" (sb_secret_...) — IGNORA o RLS. Só no servidor. Nunca com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Pix de quem recebe o sinal (a confeitaria) ---
# A chave aparece para o cliente dentro do código Pix: use CNPJ (com ou sem pontuação) ou chave aleatória.
# Nunca CPF, e-mail pessoal ou telefone.
PIX_CHAVE=12345678000190
# Nome do titular da conta (até 25 letras; acentos são removidos automaticamente)
PIX_NOME_RECEBEDOR=Nome do Titular
# Cidade (até 15 letras)
PIX_CIDADE=Salvador

# --- Site ---
# WhatsApp da confeitaria com DDD (só números). Aparece no rodapé e no botão "enviar comprovante".
NEXT_PUBLIC_WHATSAPP_LOJA=71999998888

# --- Cloudflare Turnstile (anti-robô do formulário de encomenda) ---
# Abaixo estão as CHAVES DE TESTE da Cloudflare: funcionam em localhost e sempre passam.
# Na Netlify, use as chaves do seu widget (Cloudflare > Turnstile). A secreta: marcar como secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
